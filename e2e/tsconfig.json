{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The suite runs in node, not in the browser: no `vite/client` ambient types here.
    "types": ["node"],
    "paths": {
      "@lib/*": ["./lib/*"],
      "@pages/*": ["./pages/*"]
    }
  },
  "include": ["**/*.ts", "../src/engine.ts"],
  "exclude": ["node_modules", "reports"]
}
